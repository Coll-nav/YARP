{ "Jwt": {
    "Issuer" : "GateKeeper.Auth",
    "Audience" : "GateKeeper.Api"
  },
  "ReverseProxy": {
    "Routes" : {
      "users-route" : {
        "ClusterId" : "users-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "RateLimiterPolicy" : "SlidingPolicy",
        "Match" : {
          "Path" : "/api/users/{**catch-all}"
        }
      },
      "orders-route" : {
        "ClusterId" : "orders-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "RateLimiterPolicy" : "SlidingPolicy",
        "Match" : {
          "Path" : "/api/orders/{**catch-all}"
        }
      }
    },
    "Clusters" : {
      "users-cluster" : {
        "Destinations" : {
          "users-api" : {
            "Address" : "http://localhost:5051/"
          }
        }
      }
    }
  },
  "ConnectionStrings": {
    "Redis" : "localhost6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}